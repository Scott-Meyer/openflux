{
  "name": "Discord",
  "source": "https://support.discord.com/hc/en-us/articles/225977308-Windows-Discord-Hotkeys",
  "platforms": [
    "mac",
    "windows",
    "linux"
  ],
  "apps": {
    "macos": [
      "com.hnc.Discord"
    ],
    "windows": [
      "Discord.exe"
    ],
    "linux": [
      "discord"
    ]
  },
  "shortcuts": [
    {
      "name": "Previous server",
      "context": "Navigation",
      "label": "Previous",
      "mac": "Cmd+Option+Up",
      "windows": "Ctrl+Alt+Up"
    },
    {
      "name": "Next server",
      "context": "Navigation",
      "mac": "Cmd+Option+Down",
      "windows": "Ctrl+Alt+Down"
    },
    {
      "name": "Previous channel",
      "context": "Navigation",
      "label": "Previous",
      "mac": "Option+Up",
      "windows": "Alt+Up"
    },
    {
      "name": "Next channel",
      "context": "Navigation",
      "mac": "Option+Down",
      "windows": "Alt+Down"
    },
    {
      "name": "Previous unread channel",
      "context": "Navigation",
      "label": "Previous",
      "mac": "Option+Shift+Up",
      "windows": "Alt+Shift+Up"
    },
    {
      "name": "Next unread channel",
      "context": "Navigation",
      "label": "Next unread",
      "mac": "Option+Shift+Down",
      "windows": "Alt+Shift+Down"
    },
    {
      "name": "Previous unread channel with mentions",
      "context": "Navigation",
      "label": "Previous",
      "mac": "Cmd+Option+Shift+Up",
      "windows": "Ctrl+Alt+Shift+Up"
