      "mac": "Cmd+[",
      "windows": "Ctrl+["
    },
    {
      "name": "Toggle mute",
      "context": "Calls & Voice",
      "mac": "Cmd+Shift+M",
      "windows": "Ctrl+Shift+M"
    },
    {
      "name": "Toggle deafen",
