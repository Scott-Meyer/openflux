# OpenFlux daemon as a systemd user service.
#
# Installed by the .deb to /usr/lib/systemd/user/openfluxd.service and enabled
# for every user with `systemctl --global enable`. A user can opt out with
# `systemctl --user mask --now openfluxd.service`; `disable` does not override
# the global enablement.
#
# Exit status contract: exit 0 means "stay stopped" (Quit from the tray, or
# `openfluxd --request-stop`); exit 75 (`openfluxd --request-restart` after an
# update) and any other failure make systemd start the daemon again from the
# installed binary.

[Unit]
Description=OpenFlux keyboard daemon
Documentation=https://github.com/Scott-Meyer/openflux

[Service]
Type=simple
ExecStart=/usr/bin/openfluxd
Restart=on-failure
RestartSec=2
# On stop the daemon finishes the keyboard operation in progress (a firmware
# flash or package install) before it exits; give it up to 15 minutes.
TimeoutStopSec=15min
# The daemon needs USB access (granted by 70-openflux.rules), the network
# for its local API and update checks, and the user's data directory.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
# default.target rather than graphical-session.target: not every desktop
# session activates the latter, and the daemon's USB work does not need one.
WantedBy=default.target
