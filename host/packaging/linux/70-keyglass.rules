# Keyglass keyboard access for the logged-in user.
#
# The uaccess tag gives the user of the active local seat read/write access to
# the device node through systemd-logind ACLs, so keyglassd runs without root
# and without a shared group. It must be applied before 73-seat-late.rules,
# which is why this file sorts below 73.
#
# Installed by the .deb to /usr/lib/udev/rules.d/70-keyglass.rules.
# For other installs, copy it to /etc/udev/rules.d/ and run:
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# Every Keyglass keyboard interface (USB VID 0x3761, all products):
# the libusb device node and the HID nodes. keyglassd reads the firmware's
# function-key HID interface (the Auto-Profile Lock key) through hidraw.
SUBSYSTEM=="usb", ATTRS{idVendor}=="3761", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3761", TAG+="uaccess"

# RP2040 USB boot ROM (2e8a:0003), used to read and flash the key scanner
# firmware. This ID is shared by every RP2040 board in BOOTSEL mode.
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0003", TAG+="uaccess"
