{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFlux Studio",
  "identifier": "org.openflux.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keyglass Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; frame-src 'self' http://127.0.0.1:52324; media-src 'self' http://127.0.0.1:52324 data: blob:; img-src 'self' http://127.0.0.1:52324 https://aerial-videos.netlify.app data: blob:; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "OPENFLUX_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://keyglass-dev.github.io/keyglass/updates/stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
