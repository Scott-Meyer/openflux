#!/bin/sh
set -e

ROOT="${OPENFLUX_SYSROOT:-}"
OS_BOOT_LAUNCHER="${ROOT}/usr/bin/flux-weston-autolaunch.sh"
RECOVERY_INIT="${ROOT}/etc/init.d/S05openflux-recovery"
ROLLBACK_DIR="${ROOT}/home/root/.openflux/rollback/bridge"
ARMED_FILE="${ROLLBACK_DIR}/armed"
RESCUE_STAGE_DIR="${ROOT}/home/root/.openflux/rescue"
STAGED_RESCUE_BRIDGE="${RESCUE_STAGE_DIR}/openflux-bridge"
STAGED_RESCUE_LAUNCHER="${RESCUE_STAGE_DIR}/openflux-autolaunch.sh"
STAGED_RESCUE_MANIFEST="${RESCUE_STAGE_DIR}/manifest.sha256"

flush_fs() {
    [ "${OPENFLUX_SKIP_SYNC:-0}" = "1" ] && return 0
    sync
}

file_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print tolower($1)}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print tolower($1)}'
    else
        return 1
    fi
}

verify_rescue_manifest_entry() {
    fpath="$1"
    base=$(basename "$fpath")
    actual=$(file_sha256 "$fpath") || return 1
    expected=$(awk -v b="$base" '
        {
            f = $2
            sub(/^\*\.\//, "", f)
            sub(/^\.\//, "", f)
            sub(/^\*/, "", f)
            if (f == b) { print tolower($1); exit }
        }
    ' "$STAGED_RESCUE_MANIFEST")
    [ -n "$expected" ] || return 1
    [ "$actual" = "$expected" ] || return 1
    return 0
}

# The package build substitutes the version. A missing or malformed one is recorded as "unknown",
# so the new bridge's trial marker never matches and the install isn't confirmed.
TARGET_VERSION="${OPENFLUX_TARGET_VERSION:-@OPENFLUX_VERSION@}"
case "$TARGET_VERSION" in
    *[!0-9A-Za-z._+-]*|*@*|"") TARGET_VERSION="unknown" ;;
esac

write_attempt_metadata() {
    rm -f "${ROLLBACK_DIR}"/trial-*
    ATTEMPT_ID=""
    if [ -r /dev/urandom ] && command -v od >/dev/null 2>&1; then
        ATTEMPT_ID=$(od -An -tx1 -N8 /dev/urandom 2>/dev/null | tr -d ' \n')
    fi
    if [ -z "$ATTEMPT_ID" ]; then
        ATTEMPT_ID=$(printf '%x%x' "$(date +%s)" "$$")
    fi
    printf 'attempt_id=%s\nversion=openflux-bridge %s\n' "$ATTEMPT_ID" "$TARGET_VERSION" > "${ROLLBACK_DIR}/attempt.tmp"
    mv -f "${ROLLBACK_DIR}/attempt.tmp" "${ROLLBACK_DIR}/attempt"
    flush_fs
}

install_first_conv_recovery_hooks() {
    mkdir -p "${ROOT}/usr/bin" "${ROOT}/etc/init.d"
    cat > "${RECOVERY_INIT}.tmp" <<'EOF'
#!/bin/sh
mode="${1:-start}"
case "$mode" in
    start|start-and-exec) ;;
    *) exit 0 ;;
esac

ROOT="${OPENFLUX_SYSROOT:-}"
ROLLBACK_DIR="${ROOT}/home/root/.openflux/rollback/bridge"
ARMED_FILE="${ROLLBACK_DIR}/armed"
OS_BOOT_LAUNCHER="${ROOT}/usr/bin/flux-weston-autolaunch.sh"
BRIDGE_BIN="${ROOT}/usr/lib/openflux/bridge/openflux-bridge"
BRIDGE_LAUNCHER="${ROOT}/usr/lib/openflux/bridge/openflux-autolaunch.sh"
LOG_DIR="${ROOT}/home/root/openflux/logs"

if [ ! -f "$ARMED_FILE" ]; then
    rm -f "${ROOT}/etc/init.d/S05openflux-recovery"
    if [ "$mode" = "start-and-exec" ] && [ -x "$BRIDGE_LAUNCHER" ]; then
        exec "$BRIDGE_LAUNCHER"
    fi
    exit 0
fi

flush_fs() {
    [ "${OPENFLUX_SKIP_SYNC:-0}" = "1" ] && return 0
    sync
}

atomic_copy() {
    src="$1"
    dst="$2"
    exec_flag="$3"
    mkdir -p "$(dirname "$dst")" || return 1
    cp -p "$src" "${dst}.tmp" || { rm -f "${dst}.tmp"; return 1; }
    if [ "$exec_flag" = "1" ]; then
        chmod +x "${dst}.tmp" || { rm -f "${dst}.tmp"; return 1; }
    fi
    mv -f "${dst}.tmp" "$dst" || { rm -f "${dst}.tmp"; return 1; }
    return 0
}

if [ "${OPENFLUX_TRIAL_LAUNCH:-0}" = "1" ]; then
    exit 0
fi

mkdir -p "$LOG_DIR" 2>/dev/null || true
if [ -f "${ROLLBACK_DIR}/openflux-bridge" ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - First-conversion S05openflux-recovery restoring rescue OpenFlux bridge" >> "${LOG_DIR}/autolaunch.log"
    atomic_copy "${ROLLBACK_DIR}/openflux-bridge" "$BRIDGE_BIN" 1 || exit 1
    if [ -f "${ROLLBACK_DIR}/openflux-autolaunch.sh" ]; then
        atomic_copy "${ROLLBACK_DIR}/openflux-autolaunch.sh" "$BRIDGE_LAUNCHER" 1 || exit 1
    fi
    flush_fs || exit 1
    if [ -f "${ROLLBACK_DIR}/openflux-autolaunch.sh" ]; then
        atomic_copy "$BRIDGE_LAUNCHER" "$OS_BOOT_LAUNCHER" 1 && flush_fs || exit 1
    fi
    rm -f "$ARMED_FILE" "${ROOT}/etc/init.d/S05openflux-recovery"
    flush_fs || true
fi

if [ "$mode" = "start-and-exec" ] && [ -x "$OS_BOOT_LAUNCHER" ]; then
    exec "$OS_BOOT_LAUNCHER"
fi
exit 0
EOF
    chmod +x "${RECOVERY_INIT}.tmp"
    mv -f "${RECOVERY_INIT}.tmp" "$RECOVERY_INIT"

    cat > "${OS_BOOT_LAUNCHER}.tmp" <<'EOF'
#!/bin/sh
ROOT="${OPENFLUX_SYSROOT:-}"
RECOVERY_INIT="${ROOT}/etc/init.d/S05openflux-recovery"
ARMED_FILE="${ROOT}/home/root/.openflux/rollback/bridge/armed"

if [ "${OPENFLUX_TRIAL_LAUNCH:-0}" != "1" ] && [ -f "$ARMED_FILE" ] && [ -x "$RECOVERY_INIT" ]; then
    exec "$RECOVERY_INIT" start-and-exec
fi

if [ -x "${ROOT}/usr/lib/openflux/bridge/openflux-autolaunch.sh" ]; then
    exec "${ROOT}/usr/lib/openflux/bridge/openflux-autolaunch.sh"
fi
EOF
    chmod +x "${OS_BOOT_LAUNCHER}.tmp"
    mv -f "${OS_BOOT_LAUNCHER}.tmp" "$OS_BOOT_LAUNCHER"
}

# Stop any leftover rollback watchdog from a prior or confirmed attempt before modifying ROLLBACK_DIR.
if [ -d "$ROLLBACK_DIR" ]; then
    pkill -TERM -f "${ROLLBACK_DIR}/watchdog.sh" 2>/dev/null || true
    w_wait=0
    while [ "$w_wait" -lt 10 ]; do
        pgrep -f "${ROLLBACK_DIR}/watchdog.sh" >/dev/null 2>&1 || break
        sleep "${OPENFLUX_PREINST_SLEEP:-0.1}"
        w_wait=$((w_wait + 1))
    done
    pkill -KILL -f "${ROLLBACK_DIR}/watchdog.sh" 2>/dev/null || true
fi

# Preserve existing rollback snapshots across interrupted/retried installs, while rotating attempt metadata.
if [ -f "$ARMED_FILE" ]; then
    if [ -f "${ROLLBACK_DIR}/openflux-bridge" ]; then
        write_attempt_metadata
    fi
    exit 0
fi

FIRST_CONV=0
if [ ! -f "${ROOT}/usr/lib/openflux/bridge/openflux-bridge" ]; then
    FIRST_CONV=1
    # First conversion requires a verified staged OpenFlux rescue pair before modifying any state.
    if [ ! -s "$STAGED_RESCUE_BRIDGE" ] || [ ! -s "$STAGED_RESCUE_LAUNCHER" ] || [ ! -s "$STAGED_RESCUE_MANIFEST" ]; then
        echo "ERROR: staged OpenFlux rescue pair and manifest.sha256 required in ${RESCUE_STAGE_DIR}" >&2
        exit 1
    fi
    sha_cmd=""
    if command -v sha256sum >/dev/null 2>&1; then
        sha_cmd="sha256sum"
    elif command -v shasum >/dev/null 2>&1; then
        sha_cmd="shasum -a 256"
    else
        echo "ERROR: sha256 verification tool unavailable" >&2
        exit 1
    fi
    if ! (cd "$RESCUE_STAGE_DIR" && $sha_cmd -c "$STAGED_RESCUE_MANIFEST" >/dev/null 2>&1) \
        || ! verify_rescue_manifest_entry "$STAGED_RESCUE_BRIDGE" \
        || ! verify_rescue_manifest_entry "$STAGED_RESCUE_LAUNCHER"; then
        echo "ERROR: staged OpenFlux rescue pair failed checksum verification; aborting install" >&2
        exit 1
    fi
fi

rm -rf "$ROLLBACK_DIR"
mkdir -p "$ROLLBACK_DIR"

if [ "$FIRST_CONV" -eq 0 ]; then
    cp -p "${ROOT}/usr/lib/openflux/bridge/openflux-bridge" "${ROLLBACK_DIR}/openflux-bridge"
    if [ -f "${ROOT}/usr/lib/openflux/bridge/openflux-autolaunch.sh" ]; then
        cp -p "${ROOT}/usr/lib/openflux/bridge/openflux-autolaunch.sh" "${ROLLBACK_DIR}/openflux-autolaunch.sh"
    fi
    if [ -f "${ROOT}/home/root/.openflux/versions/bridge" ]; then
        cp -p "${ROOT}/home/root/.openflux/versions/bridge" "${ROLLBACK_DIR}/bridge.version"
    fi
else
    cp -p "$STAGED_RESCUE_BRIDGE" "${ROLLBACK_DIR}/openflux-bridge"
    cp -p "$STAGED_RESCUE_LAUNCHER" "${ROLLBACK_DIR}/openflux-autolaunch.sh"
fi

flush_fs

if [ "${OPENFLUX_REQUIRE_USB_CONFIRM:-1}" != "0" ]; then
    write_attempt_metadata
    echo "pending-host-usb-confirm" > "$ARMED_FILE"
    flush_fs
    if [ "$FIRST_CONV" -eq 1 ]; then
        install_first_conv_recovery_hooks
        flush_fs
    fi
fi

exit 0
