#!/bin/sh
ROOT="${KEYGLASS_SYSROOT:-}"

# Boot entry point invoked by the keyboard's base Linux OS.
OS_BOOT_LAUNCHER="${ROOT}/usr/bin/flux-weston-autolaunch.sh"

BRIDGE_DIR="${ROOT}/usr/lib/keyglass/bridge"
BRIDGE_BIN="${BRIDGE_DIR}/keyglass-bridge"
BRIDGE_LAUNCHER="${BRIDGE_DIR}/keyglass-autolaunch.sh"
BRIDGE_FFS="${ROOT}/dev/ffs-keyglass"
ROLLBACK_DIR="${ROOT}/home/root/.keyglass/rollback/bridge"
ARMED_FILE="${ROLLBACK_DIR}/armed"
VERSION_DIR="${ROOT}/home/root/.keyglass/versions"
VERSION_FILE="${VERSION_DIR}/bridge"
LOG_DIR="${ROOT}/home/root/keyglass/logs"
READY_FILE="${KEYGLASS_READY_FILE:-${ROOT}/tmp/keyglass_bridge_ready}"
UPDATE_SEM="${ROOT}/tmp/keyglass_updating_bridge"
FACTORY_SEM="${ROOT}/tmp/updating_garfield"

flush_fs() {
    [ "${KEYGLASS_SKIP_SYNC:-0}" = "1" ] && return 0
    sync
}

atomic_restore_file() {
    src="$1"
    dst="$2"
    exec_flag="$3"
    mkdir -p "$(dirname "$dst")" || return 1
    cp -p "$src" "${dst}.tmp" || { rm -f "${dst}.tmp"; return 1; }
    if [ "$exec_flag" = "1" ]; then
        chmod +x "${dst}.tmp" || { rm -f "${dst}.tmp"; return 1; }
    fi
    mv -f "${dst}.tmp" "$dst" || { rm -f "${dst}.tmp"; return 1; }
    return 0
}

restore_rollback() {
    if [ -f "${ROLLBACK_DIR}/keyglass-bridge" ]; then
        atomic_restore_file "${ROLLBACK_DIR}/keyglass-bridge" "$BRIDGE_BIN" 1 || return 1
        if [ -f "${ROLLBACK_DIR}/bridge.version" ]; then
            atomic_restore_file "${ROLLBACK_DIR}/bridge.version" "$VERSION_FILE" 0 || return 1
        fi
        if [ -f "${ROLLBACK_DIR}/keyglass-autolaunch.sh" ]; then
            atomic_restore_file "${ROLLBACK_DIR}/keyglass-autolaunch.sh" "$BRIDGE_LAUNCHER" 1 || return 1
        fi
        flush_fs || return 1
        if [ -f "${ROLLBACK_DIR}/keyglass-autolaunch.sh" ]; then
            atomic_restore_file "$BRIDGE_LAUNCHER" "$OS_BOOT_LAUNCHER" 1 || return 1
            flush_fs || return 1
        fi
        return 0
    fi
    return 1
}

stop_services() {
    for pattern in "$BRIDGE_BIN" "$OS_BOOT_LAUNCHER" "${ROOT}/usr/lib/garfield/garfield" "${ROOT}/usr/bin/garfield"; do
        pkill -TERM -f "$pattern" 2>/dev/null || true
    done
    i=0
    while [ "$i" -lt "${KEYGLASS_STOP_WAIT_ITERS:-5}" ]; do
        alive=0
        for pattern in "$BRIDGE_BIN" "$OS_BOOT_LAUNCHER"; do
            if pgrep -f "$pattern" >/dev/null 2>&1; then
                alive=1
            fi
        done
        [ "$alive" -eq 0 ] && break
        sleep "${KEYGLASS_POSTINST_SLEEP:-1}"
        i=$((i + 1))
    done
    for pattern in "$BRIDGE_BIN" "$OS_BOOT_LAUNCHER"; do
        pkill -KILL -f "$pattern" 2>/dev/null || true
    done
}

launch_detached() {
    target="$1"
    arg1="$2"
    logfile="$3"
    if [ -n "$arg1" ]; then
        sh -c 'nohup "$1" "$2" </dev/null >"$3" 2>&1 & echo "$!"' sh "$target" "$arg1" "$logfile"
    else
        sh -c 'nohup "$1" </dev/null >"$2" 2>&1 & echo "$!"' sh "$target" "$logfile"
    fi
}

launch_services() {
    trial_mode="${1:-trial}"
    trial_attempt_id=""
    if [ "$trial_mode" = "trial" ] && [ -f "${ROLLBACK_DIR}/attempt" ]; then
        trial_attempt_id=$(awk -F= '$1=="attempt_id"{print $2; exit}' "${ROLLBACK_DIR}/attempt" 2>/dev/null || true)
    fi
    if [ -x "$OS_BOOT_LAUNCHER" ]; then
        if [ "$trial_mode" = "trial" ]; then
            KEYGLASS_TRIAL_LAUNCH=1 KEYGLASS_TRIAL_ATTEMPT_ID="$trial_attempt_id" launch_detached "$OS_BOOT_LAUNCHER" "" "${LOG_DIR}/autolaunch.log"
        else
            KEYGLASS_TRIAL_LAUNCH=0 KEYGLASS_TRIAL_ATTEMPT_ID="" launch_detached "$OS_BOOT_LAUNCHER" "" "${LOG_DIR}/autolaunch.log"
        fi
    elif [ -x "$BRIDGE_BIN" ]; then
        if [ "$trial_mode" = "trial" ]; then
            KEYGLASS_TRIAL_ATTEMPT_ID="$trial_attempt_id" launch_detached "$BRIDGE_BIN" "$BRIDGE_FFS" "${LOG_DIR}/bridge.log"
        else
            KEYGLASS_TRIAL_ATTEMPT_ID="" launch_detached "$BRIDGE_BIN" "$BRIDGE_FFS" "${LOG_DIR}/bridge.log"
        fi
    fi
}

is_pid_running() {
    pid="$1"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    stat=$(ps -p "$pid" -o stat= 2>/dev/null | tr -d ' ')
    case "$stat" in
        ""|Z*) return 1 ;;
        *) return 0 ;;
    esac
}

rollback_and_relaunch() {
    touch "$UPDATE_SEM"
    stop_services
    if ! restore_rollback; then
        echo "ERROR: bridge rollback restore/flush failed; preserving armed sentinel and snapshots" >&2
        rm -f "$UPDATE_SEM" "$FACTORY_SEM" "$READY_FILE"
        return 1
    fi
    rm -f "$UPDATE_SEM" "$FACTORY_SEM" "$READY_FILE" "$ARMED_FILE"
    flush_fs || true
    launch_services rollback >/dev/null
    return 0
}

chmod +x "$BRIDGE_BIN" "$BRIDGE_LAUNCHER" "${BRIDGE_DIR}/restore-factory.sh" 2>/dev/null || true
mkdir -p "$BRIDGE_FFS" "$LOG_DIR" "$VERSION_DIR" "$ROLLBACK_DIR"
chmod 755 "$BRIDGE_FFS"

if [ -f "$BRIDGE_LAUNCHER" ]; then
    atomic_restore_file "$BRIDGE_LAUNCHER" "$OS_BOOT_LAUNCHER" 1 || true
fi

touch "$UPDATE_SEM"
stop_services
rm -f "$READY_FILE"

if [ "${KEYGLASS_REQUIRE_USB_CONFIRM:-1}" != "0" ] && [ -f "${ROLLBACK_DIR}/keyglass-bridge" ]; then
    echo "pending-host-usb-confirm" > "$ARMED_FILE"
    flush_fs || true
fi

rm -f "$UPDATE_SEM" "$FACTORY_SEM"
launcher_pid=$(launch_services)

# Verify launcher and the actual bridge PID inside READY_FILE remain alive across a stabilization check.
require_ready="${KEYGLASS_REQUIRE_READY_FILE:-1}"
ready_ok=0
j=0
max_ready="${KEYGLASS_READY_WAIT_ITERS:-15}"
while [ "$j" -lt "$max_ready" ]; do
    if ! is_pid_running "$launcher_pid"; then
        ready_ok=0
        break
    fi
    if [ "$require_ready" = "0" ]; then
        ready_ok=1
        break
    fi
    if [ -f "$READY_FILE" ]; then
        daemon_pid=$(cat "$READY_FILE" 2>/dev/null | tr -d ' \t\r\n')
        case "$daemon_pid" in
            ""|*[!0-9]*) ;;
            *)
                if is_pid_running "$daemon_pid"; then
                    sleep "${KEYGLASS_STABILIZE_SLEEP:-${KEYGLASS_STARTUP_CHECK_SLEEP:-0.2}}"
                    if is_pid_running "$launcher_pid" && is_pid_running "$daemon_pid"; then
                        ready_ok=1
                        break
                    fi
                    ready_ok=0
                    break
                fi
                ;;
        esac
    fi
    sleep "${KEYGLASS_STARTUP_CHECK_SLEEP:-0.2}"
    j=$((j + 1))
done

if [ "$ready_ok" -ne 1 ]; then
    echo "ERROR: keyglass-bridge failed readiness check; rolling back" >&2
    rollback_and_relaunch || true
    exit 1
fi

echo "keyglass-bridge @KEYGLASS_VERSION@" > "$VERSION_FILE"

if [ "${KEYGLASS_REQUIRE_USB_CONFIRM:-1}" != "0" ] && [ -f "$ARMED_FILE" ]; then
    confirm_iters="${KEYGLASS_USB_CONFIRM_ITERS:-60}"
    confirm_sleep="${KEYGLASS_USB_CONFIRM_SLEEP:-1}"
    WATCHDOG_ATTEMPT_ID=""
    if [ -f "${ROLLBACK_DIR}/attempt" ]; then
        WATCHDOG_ATTEMPT_ID=$(awk -F= '$1=="attempt_id"{print $2; exit}' "${ROLLBACK_DIR}/attempt" 2>/dev/null || true)
    fi
    WATCHDOG_SH="${ROLLBACK_DIR}/watchdog.sh"
    cat > "$WATCHDOG_SH" <<EOF
#!/bin/sh
WATCHDOG_ATTEMPT_ID="$WATCHDOG_ATTEMPT_ID"

attempt_matches() {
    [ -n "\$WATCHDOG_ATTEMPT_ID" ] || return 0
    [ -f "${ROLLBACK_DIR}/attempt" ] || return 1
    cur=\$(awk -F= '\$1=="attempt_id"{print \$2; exit}' "${ROLLBACK_DIR}/attempt" 2>/dev/null || true)
    [ "\$cur" = "\$WATCHDOG_ATTEMPT_ID" ]
}

flush_fs() {
    [ "\${KEYGLASS_SKIP_SYNC:-0}" = "1" ] && return 0
    sync
}

atomic_restore_file() {
    src="\$1"
    dst="\$2"
    exec_flag="\$3"
    mkdir -p "\$(dirname "\$dst")" || return 1
    cp -p "\$src" "\${dst}.tmp" || { rm -f "\${dst}.tmp"; return 1; }
    if [ "\$exec_flag" = "1" ]; then
        chmod +x "\${dst}.tmp" || { rm -f "\${dst}.tmp"; return 1; }
    fi
    mv -f "\${dst}.tmp" "\$dst" || { rm -f "\${dst}.tmp"; return 1; }
    return 0
}

k=0
while [ "\$k" -lt "$confirm_iters" ]; do
    attempt_matches || exit 0
    if [ ! -f "$ARMED_FILE" ]; then
        attempt_matches && rm -rf "$ROLLBACK_DIR"
        exit 0
    fi
    sleep "$confirm_sleep"
    k=\$((k + 1))
done
attempt_matches || exit 0
if [ -f "$ARMED_FILE" ]; then
    echo "\$(date '+%Y-%m-%d %H:%M:%S') - bridge USB confirm timeout; rolling back" >> "${LOG_DIR}/bridge_rollback.log"
    touch "$UPDATE_SEM"
    for pat in "$BRIDGE_BIN" "$OS_BOOT_LAUNCHER"; do
        pkill -TERM -f "\$pat" 2>/dev/null || true
    done
    sleep "${KEYGLASS_POSTINST_SLEEP:-1}"
    for pat in "$BRIDGE_BIN" "$OS_BOOT_LAUNCHER"; do
        pkill -KILL -f "\$pat" 2>/dev/null || true
    done
    ok=0
    if [ -f "${ROLLBACK_DIR}/keyglass-bridge" ]; then
        ok=1
        atomic_restore_file "${ROLLBACK_DIR}/keyglass-bridge" "$BRIDGE_BIN" 1 || ok=0
        if [ "\$ok" -eq 1 ] && [ -f "${ROLLBACK_DIR}/bridge.version" ]; then
            atomic_restore_file "${ROLLBACK_DIR}/bridge.version" "$VERSION_FILE" 0 || ok=0
        fi
        if [ "\$ok" -eq 1 ] && [ -f "${ROLLBACK_DIR}/keyglass-autolaunch.sh" ]; then
            atomic_restore_file "${ROLLBACK_DIR}/keyglass-autolaunch.sh" "$BRIDGE_LAUNCHER" 1 || ok=0
        fi
        if [ "\$ok" -ne 1 ] || ! flush_fs; then
            ok=0
        elif [ -f "${ROLLBACK_DIR}/keyglass-autolaunch.sh" ]; then
            atomic_restore_file "$BRIDGE_LAUNCHER" "$OS_BOOT_LAUNCHER" 1 && flush_fs || ok=0
        fi
    fi
    if [ "\$ok" -ne 1 ]; then
        echo "\$(date '+%Y-%m-%d %H:%M:%S') - ERROR: watchdog rollback copy/flush failed; preserving armed sentinel" >> "${LOG_DIR}/bridge_rollback.log"
        rm -f "$UPDATE_SEM" "$READY_FILE"
        exit 1
    fi
    rm -f "$UPDATE_SEM" "$READY_FILE" "$ARMED_FILE"
    flush_fs || true
    if [ -x "$OS_BOOT_LAUNCHER" ]; then
        nohup "$OS_BOOT_LAUNCHER" </dev/null >>"${LOG_DIR}/autolaunch.log" 2>&1 &
    elif [ -x "$BRIDGE_BIN" ]; then
        nohup "$BRIDGE_BIN" "$BRIDGE_FFS" </dev/null >>"${LOG_DIR}/bridge.log" 2>&1 &
    fi
fi
EOF
    chmod 0755 "$WATCHDOG_SH"
    nohup sh "$WATCHDOG_SH" </dev/null >/dev/null 2>&1 &
else
    rm -rf "$ROLLBACK_DIR"
fi

exit 0
