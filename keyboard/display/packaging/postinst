#!/bin/sh
ROOT="${KEYGLASS_SYSROOT:-}"
DISPLAY_DIR="${ROOT}/usr/lib/keyglass/display"
VERSION_DIR="${ROOT}/home/root/.keyglass/versions"
VERSION_FILE="${VERSION_DIR}/display"

chmod +x "${DISPLAY_DIR}/keyglass-display" 2>/dev/null || true
if [ -f "${DISPLAY_DIR}/keyglass-ffmpeg" ]; then
    chmod +x "${DISPLAY_DIR}/keyglass-ffmpeg" 2>/dev/null || true
fi
mkdir -p "$VERSION_DIR" "${ROOT}/home/root/keyglass/logs"
echo "keyglass-display @KEYGLASS_VERSION@" > "$VERSION_FILE"
rm -f "${ROOT}/tmp/keyglass_updating_display" "${ROOT}/tmp/updating_garfunkel"
exit 0
