# Container for cross-building keyglass-display and keyglass-ffmpeg (`keyboard/display` build context).
# rust:1-slim-bookworm
FROM rust:1-slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37
ARG FFMPEG_VERSION=6.1.2
ARG FFMPEG_SHA256=3b624649725ecdc565c903ca6643d41f33bd49239922e45c9b1442c63dca4e38
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    gcc g++ make musl-tools libc6-dev gcc-aarch64-linux-gnu g++-aarch64-linux-gnu libc6-dev-arm64-cross \
    libwayland-dev wayland-protocols libjpeg62-turbo-dev libegl-dev libgles-dev \
    weston ffmpeg qemu-user-static python3 file curl ca-certificates xz-utils bzip2 pkg-config && \
    rustup toolchain install 1.90.0 --profile minimal --component rustc,cargo,rust-std && \
    rustup default 1.90.0 && \
    rustup target add --toolchain 1.90.0 aarch64-unknown-linux-musl aarch64-unknown-linux-gnu && \
    if [ "$(uname -m)" != "aarch64" ]; then \
      mkdir -p /usr/local/cargo && \
      printf '[target.aarch64-unknown-linux-gnu]\nlinker = "aarch64-linux-gnu-gcc"\n[target.aarch64-unknown-linux-musl]\nlinker = "aarch64-linux-gnu-gcc"\n' >> /usr/local/cargo/config.toml; \
    fi && \
    mkdir -p /tmp/ff /opt/keyglass-ffmpeg && \
    curl -fsSL "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" -o "/opt/keyglass-ffmpeg/keyglass-ffmpeg-source-${FFMPEG_VERSION}.tar.xz" && \
    echo "${FFMPEG_SHA256}  /opt/keyglass-ffmpeg/keyglass-ffmpeg-source-${FFMPEG_VERSION}.tar.xz" | sha256sum -c - && \
    tar -xJf "/opt/keyglass-ffmpeg/keyglass-ffmpeg-source-${FFMPEG_VERSION}.tar.xz" -C /tmp/ff && \
    cd "/tmp/ff/ffmpeg-${FFMPEG_VERSION}" && \
    cp COPYING.LGPLv2.1 /opt/keyglass-ffmpeg/FFMPEG-LGPL-2.1.txt && \
    CROSS_FLAGS=""; \
    CC_NAME="gcc"; \
    if [ "$(uname -m)" != "aarch64" ]; then \
      CROSS_FLAGS="--enable-cross-compile --arch=aarch64 --target-os=linux --cross-prefix=aarch64-linux-gnu-"; \
      CC_NAME="aarch64-linux-gnu-gcc"; \
    fi && \
    CONFIGURE_FLAGS="$CROSS_FLAGS --enable-static --disable-shared --disable-doc --disable-htmlpages --disable-manpages --disable-podpages --disable-txtpages --disable-debug --disable-ffplay --disable-ffprobe --disable-everything --enable-ffmpeg --enable-decoder=h264,hevc,vp8,vp9,mpeg4,mjpeg,gif,rawvideo --enable-encoder=rawvideo --enable-demuxer=mov,matroska,avi,gif,image2 --enable-muxer=rawvideo,hevc,h264 --enable-bsf=hevc_mp4toannexb,h264_mp4toannexb --enable-parser=h264,hevc,vp8,vp9,mpeg4video,mjpeg --enable-protocol=file,pipe --enable-filter=scale,fps,format --enable-swscale --enable-small --extra-ldflags=-static" && \
    ./configure --prefix=/opt/keyglass-ffmpeg $CONFIGURE_FLAGS && \
    make -j"$(nproc)" && \
    cp ffmpeg /opt/keyglass-ffmpeg/keyglass-ffmpeg && \
    if [ "$(uname -m)" != "aarch64" ]; then aarch64-linux-gnu-strip /opt/keyglass-ffmpeg/keyglass-ffmpeg; else strip /opt/keyglass-ffmpeg/keyglass-ffmpeg; fi && \
    { \
      echo "component=keyglass-ffmpeg"; \
      echo "ffmpeg_version=${FFMPEG_VERSION}"; \
      echo "source_tarball=keyglass-ffmpeg-source-${FFMPEG_VERSION}.tar.xz"; \
      echo "source_sha256=${FFMPEG_SHA256}"; \
      echo "license=LGPL-2.1-or-later (COPYING.LGPLv2.1)"; \
      echo "toolchain=$($CC_NAME --version | head -n 1)"; \
      echo "configure_flags=$CONFIGURE_FLAGS"; \
      echo "linking_note=Statically linked against Debian Bookworm glibc (-static) to remain independent of host target libc symbol versions; LGPL-2.1 corresponding source tarball and build configuration are published with each release."; \
    } > /opt/keyglass-ffmpeg/keyglass-ffmpeg-build.txt && \
    rm -rf /tmp/ff && \
    rm -rf /var/lib/apt/lists/*
# cargo-about writes the license texts of the Rust crates in the package
# (scripts/licenses/rust-licenses.sh); same version and checksums as
# scripts/licenses/install-cargo-about.sh.
ARG CARGO_ABOUT_VERSION=0.9.3
ARG CARGO_ABOUT_SHA256_AARCH64=eb4d9ff6ebd2518152a8308729431a04b3836e71d2bd5ead7aea69f91a71162e
ARG CARGO_ABOUT_SHA256_X86_64=3ad1e94ea1e63d69d1961f4fb15ccbbe9575d906111f96d2cb4dce6df48f71b4
RUN case "$(uname -m)" in \
      aarch64) triple=aarch64-unknown-linux-musl sha="${CARGO_ABOUT_SHA256_AARCH64}" ;; \
      x86_64) triple=x86_64-unknown-linux-musl sha="${CARGO_ABOUT_SHA256_X86_64}" ;; \
      *) echo "no cargo-about for $(uname -m)" >&2; exit 1 ;; \
    esac && \
    name="cargo-about-${CARGO_ABOUT_VERSION}-${triple}" && \
    curl -fsSL --retry 3 -o "/tmp/${name}.tar.gz" \
      "https://github.com/EmbarkStudios/cargo-about/releases/download/${CARGO_ABOUT_VERSION}/${name}.tar.gz" && \
    echo "${sha}  /tmp/${name}.tar.gz" | sha256sum -c - && \
    tar -xzf "/tmp/${name}.tar.gz" -C /tmp && \
    install -m 0755 "/tmp/${name}/cargo-about" /usr/local/cargo/bin/cargo-about && \
    rm -rf "/tmp/${name}" "/tmp/${name}.tar.gz"
WORKDIR /work
