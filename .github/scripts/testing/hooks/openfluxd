#!/bin/sh
# Stand-in for openfluxd --request-restart|--request-stop. Answers with the
# next status from $FAKE_HOOKS/codes (one per line; the last one repeats)
# and logs each call with its environment to $FAKE_HOOKS/requests.log.
set -eu
codes="${FAKE_HOOKS:?}/codes"
code="$(head -n 1 "$codes")"
if [ "$(wc -l < "$codes")" -gt 1 ]; then
    tail -n +2 "$codes" > "${codes}.next" && mv "${codes}.next" "$codes"
fi
echo "$* user=$(id -un 2>/dev/null || echo ?) HOME=${HOME:-} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}" >> "${FAKE_HOOKS}/requests.log"
case "$code" in
    0) echo "stopped" ;;
    3) echo "deferred" ;;
    4) echo "not-running" ;;
    *) echo "error: scripted failure" >&2 ;;
esac
exit "$code"
